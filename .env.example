# CapacitaHub - Variables de Entorno de Producción
# Copie este archivo a .env y configure valores seguros antes de desplegar en producción.

# Clave secreta para la firma y verificación de tokens JWT (OBLIGATORIA EN PRODUCCIÓN)
# Genere una clave de alta entropía (mínimo 32 caracteres / 256 bits), ej: openssl rand -base64 32
JWT_SECRET=cambiar_este_valor_por_un_secreto_seguro_y_aleatorio_2026

# Puerto del servidor API
PORT=5000

# Cadena de conexión a PostgreSQL
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/capacitahub_db

# Lista blanca de orígenes permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:3020,http://127.0.0.1:3020
